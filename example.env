########################################
# Discord Bot
########################################

# Discord bot token from the Developer Portal
DISCORD_TOKEN=changeme

# Roles
OWNER_ID=123456789012345678
MOD_ROLE_ID=123456789012345678

# Optional scoping
ALLOWED_CHANNEL_ID=123456789012345678
GUILD_ID=123456789012345678


########################################
# Crafty API
########################################

# Base URL to Crafty API
# Examples:
#   http://crafty:8443/api/v2          (Docker internal network)
#   https://crafty.example.com/api/v2  (Public HTTPS reverse proxy)
CRAFTY_URL=https://changeme

# Crafty API token for a service account with permission
# to start/stop/restart the servers you want the bot to control
CRAFTY_TOKEN=changeme


########################################
# Server auto-discovery
########################################

# Servers are auto-discovered from Crafty (GET /servers). New servers created in
# Crafty appear in /mc automatically; deleted ones disappear. No manual list needed.

# How often (minutes) the bot re-pulls the server list from Crafty. Default: 5.
# Changing this requires recreating the container.
REFRESH_INTERVAL_MINUTES=5


########################################
# Optional offline fallback (servers.json)
########################################

# The server definitions below are OPTIONAL and used only as a fallback seed if
# Crafty is unreachable when the bot starts. Once Crafty is reachable, the live
# list from Crafty always takes over. Most setups can leave these unset.

# OPTIONAL: Path to a JSON file used as the offline seed. See servers.json.example.
SERVERS_FILE=servers.json

# OPTIONAL: A JSON string used as the offline seed (useful for some CI/containers)
# MC_SERVERS_JSON='[{"key": "surv", "name": "Survival", "id": "uuid"}, ...]'

# DEPRECATED: Legacy per-index seed pattern (only used if the two above are absent)
# MC_SERVER_1_KEY=surv
# MC_SERVER_1_NAME=Survival
# MC_SERVER_1_ID=00000000-0000-0000-0000-000000000001


########################################
# Optional: Logging Config
########################################

# INFO is usually fine. DEBUG is chatty and useful for troubleshooting.
LOG_LEVEL=INFO

# true/false – enable JSON structured logs (good for containers)
LOG_JSON=false


########################################
# User variables (for Docker)
########################################

# PUID/PGID should match the user that owns your volumes
PUID=<your-PUID>
PGID=<your-PGID>

# Example: America/New_York, Europe/London, Etc/UTC
TZ=YourTZ/ETC
